pipeline {
    agent any

    parameters {
        choice(name: 'Diretorio', choices: ['envs'], description: 'Diretório raiz')
        choice(name: 'Ambiente', choices: ['base', 'lab','prod', ' test'], description: 'Ambiente do stack')
        choice(name: 'Site', choices: ['vsphere-516', 'vsphere-k'], description: 'Site vCenter')
        string(name: 'Grupo', defaultValue: 'vms-etls', description: 'Pasta do stack (ex.: vms-etls, vms-wildfly)')
        string(name: 'VmName', defaultValue: '', description: 'Nome da VM no HCL (chave for_each / staticvmname). Ex.: PDWH03-JDK11')
        string(name: 'VmId', defaultValue: '', description: 'UUID da VM no vCenter (recomendado) ou MOID da URL (vm-XXXX)')
        choice(name: 'Tipo', choices: ['linux', 'windows'], description: 'Módulo da VM (mesmo resource address nos dois)')
        booleanParam(name: 'RodarPlanAposImport', defaultValue: true, description: 'Após o import, executa terragrunt plan para ver drift')
        booleanParam(name: 'PularAprovacao', defaultValue: false, description: 'Se true, não pede confirmação antes do import')
    }

    environment {
        VAULT_ADDR = 'https://vault.app.sof.intra'
        TF_IN_AUTOMATION = 'true'
        PG_BACKEND_CREDENTIAL_ID = 'terraform-pg-backend'
    }

    stages {
        stage('Validar parâmetros') {
            steps {
                script {
                    if (!params.VmName?.trim()) {
                        error('Parâmetro VmName é obrigatório (nome da VM no terragrunt.hcl / staticvmname).')
                    }
                    if (!params.VmId?.trim()) {
                        error('Parâmetro VmId é obrigatório (UUID ou MOID da VM no vCenter).')
                    }
                    def stackPath = "${params.Diretorio}/${params.Ambiente}/${params.Site}/${params.Grupo}"
                    if (!fileExists(stackPath)) {
                        error("Stack não encontrado: ${stackPath}")
                    }
                    echo "Import destino: ${stackPath}"
                    echo "Recurso: vsphere_virtual_machine.vm[\"${params.VmName.trim()}\"]"
                    echo "ID vCenter: ${params.VmId.trim()}"
                }
            }
        }

        stage('Prepare Environment') {
            steps {
                script {
                    sh 'cp pipelines/conf/terragrunt.hcl envs/ || true'
                }
            }
        }

        stage('Aprovação do import') {
            when {
                expression { return !params.PularAprovacao }
            }
            steps {
                script {
                    timeout(time: 60, unit: 'MINUTES') {
                        input(
                            message: """Confirma IMPORTAR a VM no tfstate (PostgreSQL)?

Ambiente: ${params.Ambiente}
Site: ${params.Site}
Grupo: ${params.Grupo}
VmName (HCL): ${params.VmName}
VmId (vCenter): ${params.VmId}

Isso NÃO cria/altera a VM no vCenter — só associa o recurso existente ao state.""",
                            ok: 'Aprovar e importar',
                            submitterParameter: 'APROVADO_POR'
                        )
                    }
                    echo "Import autorizado (submitter: ${params.APROVADO_POR ?: '—'}). Prosseguindo."
                }
            }
        }

        stage('Terragrunt Import') {
            steps {
                script {
                    dir("${params.Diretorio}/${params.Ambiente}/${params.Site}/${params.Grupo}") {
                        def secretsVcenter = [
                            [path: 'secrets/servicos/user_svc_jenkins', engineVersion: 2, secretValues: [
                                [envVar: 'passwd_vcenter', vaultKey: 'password']]]
                        ]
                        def vaultConfiguration = [vaultUrl: 'https://vault.app.sof.intra',
                            vaultCredentialId: 'vault_approle_jenkins',
                            engineVersion: 2]
                        withCredentials([
                            usernamePassword(credentialsId: env.PG_BACKEND_CREDENTIAL_ID,
                                usernameVariable: 'TF_VAR_backend_pg_user',
                                passwordVariable: 'TF_VAR_backend_pg_passwd'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_516', variable: 'TF_VAR_hostname_vcenter_516'),
                            string(credentialsId: 'TF_VAR_username_vcenter_516', variable: 'TF_VAR_username_vcenter_516'),
                            string(credentialsId: 'TF_VAR_password_vcenter_516', variable: 'TF_VAR_password_vcenter_516'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_k', variable: 'TF_VAR_hostname_vcenter_k'),
                            string(credentialsId: 'TF_VAR_username_vcenter_k', variable: 'TF_VAR_username_vcenter_k'),
                            string(credentialsId: 'TF_VAR_password_vcenter_k', variable: 'TF_VAR_password_vcenter_k'),
                            string(credentialsId: 'ansible_pass_text', variable: 'TF_VAR_VM_PASS')
                        ]) {
                            withVault([configuration: vaultConfiguration, vaultSecrets: secretsVcenter]) {
                                def vcenterHostRaw = (params.Site == 'vsphere-516') ? env.TF_VAR_hostname_vcenter_516 : env.TF_VAR_hostname_vcenter_k
                                env.VSPHERE_SERVER = vcenterHostRaw?.trim()?.replaceAll('(?i)^https?://', '')?.replaceAll('/.*', '') ?: ''
                                env.VCENTER_SITE   = params.Site
                                env.IMPORT_VM_NAME = params.VmName.trim()
                                env.IMPORT_VM_ID   = params.VmId.trim()
                                // Legado em vários terragrunt.hcl (get_env sem default). Módulo linux não usa.
                                env.TF_VAR_DISTRO  = 'unused'

                                sh '''
                                    . "${WORKSPACE}/pipelines/conf/vsphere-preflight.sh"
                                    vsphere_preflight

                                    echo "DEBUG: listando state antes do import..."
                                    terragrunt state list || true

                                    # Endereço for_each: vsphere_virtual_machine.vm["NOME"]
                                    ADDR="vsphere_virtual_machine.vm[\"${IMPORT_VM_NAME}\"]"
                                    echo "Executando: terragrunt import ${ADDR} ${IMPORT_VM_ID}"
                                    terragrunt import "${ADDR}" "${IMPORT_VM_ID}"

                                    echo "DEBUG: listando state após o import..."
                                    terragrunt state list | grep -F "vsphere_virtual_machine.vm" || terragrunt state list
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Terragrunt Plan (pós-import)') {
            when {
                expression { return params.RodarPlanAposImport }
            }
            steps {
                script {
                    dir("${params.Diretorio}/${params.Ambiente}/${params.Site}/${params.Grupo}") {
                        def secretsVcenter = [
                            [path: 'secrets/servicos/user_svc_jenkins', engineVersion: 2, secretValues: [
                                [envVar: 'passwd_vcenter', vaultKey: 'password']]]
                        ]
                        def vaultConfiguration = [vaultUrl: 'https://vault.app.sof.intra',
                            vaultCredentialId: 'vault_approle_jenkins',
                            engineVersion: 2]
                        withCredentials([
                            usernamePassword(credentialsId: env.PG_BACKEND_CREDENTIAL_ID,
                                usernameVariable: 'TF_VAR_backend_pg_user',
                                passwordVariable: 'TF_VAR_backend_pg_passwd'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_516', variable: 'TF_VAR_hostname_vcenter_516'),
                            string(credentialsId: 'TF_VAR_username_vcenter_516', variable: 'TF_VAR_username_vcenter_516'),
                            string(credentialsId: 'TF_VAR_password_vcenter_516', variable: 'TF_VAR_password_vcenter_516'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_k', variable: 'TF_VAR_hostname_vcenter_k'),
                            string(credentialsId: 'TF_VAR_username_vcenter_k', variable: 'TF_VAR_username_vcenter_k'),
                            string(credentialsId: 'TF_VAR_password_vcenter_k', variable: 'TF_VAR_password_vcenter_k'),
                            string(credentialsId: 'ansible_pass_text', variable: 'TF_VAR_VM_PASS')
                        ]) {
                            withVault([configuration: vaultConfiguration, vaultSecrets: secretsVcenter]) {
                                def vcenterHostRaw = (params.Site == 'vsphere-516') ? env.TF_VAR_hostname_vcenter_516 : env.TF_VAR_hostname_vcenter_k
                                env.VSPHERE_SERVER = vcenterHostRaw?.trim()?.replaceAll('(?i)^https?://', '')?.replaceAll('/.*', '') ?: ''
                                env.VCENTER_SITE   = params.Site
                                env.TF_VAR_DISTRO  = 'unused'
                                sh '''
                                    . "${WORKSPACE}/pipelines/conf/vsphere-preflight.sh"
                                    vsphere_preflight
                                    echo "Plan pós-import: revise drift. NÃO aplique destroy/recreate sem analisar."
                                    terragrunt plan -lock=true
                                '''
                            }
                        }
                    }
                }
            }
        }
    }
}
