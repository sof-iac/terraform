pipeline {
    agent any

    parameters {
        choice(name: 'Projeto', choices: ['infra', 'devops', 'labcoinf', 'siop'], description: 'Organização Gitea')
        choice(name: 'Diretorio', choices: ['envs', 'aws'], description: 'Diretorio raiz')
        choice(name: 'Ambiente', choices: ['prod', 'base', 'test', 'lab'], description: 'Ambiente')
        choice(name: 'Site', choices: ['vsphere-516', 'vsphere-k'], description: 'Site')
        string(name: 'Grupo', defaultValue: 'category_vcenter', description: 'Pasta do stack (ex.: category_vcenter)')
        booleanParam(name: 'PularAprovacao', defaultValue: false, description: 'Se true, não pede confirmação entre plan e apply.')
    }

    environment {
        VAULT_ADDR = 'https://vault.app.sof.intra'
        TF_IN_AUTOMATION = 'true'
        PG_BACKEND_CREDENTIAL_ID = 'terraform-pg-backend'
    }

    stages {
        stage('Retornando as chaves publica e certificados') {
            steps {
                script {
                    dir("${Diretorio}/${Ambiente}/${Site}") {
                        def vcenterUserCredId = (params.Site == 'vsphere-516')
                            ? 'TF_VAR_username_vcenter_516'
                            : 'TF_VAR_username_vcenter_k'
                        def secrets_vcenter = [
                            [path: 'secrets/servicos/user_svc_jenkins', engineVersion: 2, secretValues: [
                                [envVar: 'passwd_vcenter', vaultKey: 'password']]]
                        ]
                        def configuration = [vaultUrl: 'https://vault.app.sof.intra',
                            vaultCredentialId: 'vault_approle_jenkins',
                            engineVersion: 2]
                        withCredentials([string(credentialsId: vcenterUserCredId, variable: 'USER_VCENTER')]) {
                            withVault([configuration: configuration, vaultSecrets: secrets_vcenter]) {
                                sh "echo '{\\n  \"username_vcenter\": \"${env.USER_VCENTER}\",\\n  \"passwd_vcenter\": \"${passwd_vcenter}\"\\n}' > secrets.json"
                            }
                        }
                    }
                }
            }
        }

        stage('Prepare Environment') {
            steps {
                script {
                    sh 'cp pipelines/conf/terragrunt.hcl envs/ || true'
                }
            }
        }

        stage('Terragrunt Plan') {
            steps {
                script {
                    echo "DEBUG Credentials: PG_BACKEND_CREDENTIAL_ID=${env.PG_BACKEND_CREDENTIAL_ID} | ambiente=${params.Ambiente} | site=${params.Site}"

                    dir("${Diretorio}/${Ambiente}/${Site}/${Grupo}") {
                        def secretsVcenter = [
                            [path: 'secrets/servicos/user_svc_jenkins', engineVersion: 2, secretValues: [
                                [envVar: 'passwd_vcenter', vaultKey: 'password']]]
                        ]
                        def vaultConfiguration = [vaultUrl: 'https://vault.app.sof.intra',
                            vaultCredentialId: 'vault_approle_jenkins',
                            engineVersion: 2]
                        withCredentials([
                            usernamePassword(credentialsId: env.PG_BACKEND_CREDENTIAL_ID,
                                usernameVariable: 'TF_VAR_backend_pg_user',
                                passwordVariable: 'TF_VAR_backend_pg_passwd'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_516', variable: 'TF_VAR_hostname_vcenter_516'),
                            string(credentialsId: 'TF_VAR_username_vcenter_516', variable: 'TF_VAR_username_vcenter_516'),
                            string(credentialsId: 'TF_VAR_password_vcenter_516', variable: 'TF_VAR_password_vcenter_516'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_k', variable: 'TF_VAR_hostname_vcenter_k'),
                            string(credentialsId: 'TF_VAR_username_vcenter_k', variable: 'TF_VAR_username_vcenter_k'),
                            string(credentialsId: 'TF_VAR_password_vcenter_k', variable: 'TF_VAR_password_vcenter_k')
                        ]) {
                            withVault([configuration: vaultConfiguration, vaultSecrets: secretsVcenter]) {
                                def vcenterHostRaw = (params.Site == 'vsphere-516') ? env.TF_VAR_hostname_vcenter_516 : env.TF_VAR_hostname_vcenter_k
                                env.VSPHERE_SERVER = vcenterHostRaw?.trim()?.replaceAll('(?i)^https?://', '')?.replaceAll('/.*', '') ?: ''
                                env.VCENTER_SITE   = params.Site
                                sh '''
                                    . "${WORKSPACE}/pipelines/conf/vsphere-preflight.sh"
                                    vsphere_preflight
                                    echo "DEBUG TF_VAR_backend_pg_user: set=${TF_VAR_backend_pg_user:+yes} length=${#TF_VAR_backend_pg_user}"
                                    echo "DEBUG TF_VAR_backend_pg_passwd: set=${TF_VAR_backend_pg_passwd:+yes} length=${#TF_VAR_backend_pg_passwd}"
                                    terragrunt plan -lock=true
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Aprovação do apply') {
            when {
                expression { return !params.PularAprovacao }
            }
            steps {
                script {
                    timeout(time: 120, unit: 'MINUTES') {
                        input(
                            message: "Revise o output do Terragrunt Plan acima.\n\nAmbiente: ${params.Ambiente} | Site: ${params.Site} | Grupo: ${params.Grupo}\n\nConfirma a execução do terragrunt apply (category vCenter)?",
                            ok: 'Aprovar e executar apply',
                            submitterParameter: 'APROVADO_POR'
                        )
                    }
                    echo "Apply autorizado (submitter: ${params.APROVADO_POR ?: '—'}). Prosseguindo."
                }
            }
        }

        stage('Terragrunt Apply') {
            steps {
                script {
                    dir("${Diretorio}/${Ambiente}/${Site}/${Grupo}") {
                        def secretsVcenter = [
                            [path: 'secrets/servicos/user_svc_jenkins', engineVersion: 2, secretValues: [
                                [envVar: 'passwd_vcenter', vaultKey: 'password']]]
                        ]
                        def vaultConfiguration = [vaultUrl: 'https://vault.app.sof.intra',
                            vaultCredentialId: 'vault_approle_jenkins',
                            engineVersion: 2]
                        withCredentials([
                            usernamePassword(credentialsId: env.PG_BACKEND_CREDENTIAL_ID,
                                usernameVariable: 'TF_VAR_backend_pg_user',
                                passwordVariable: 'TF_VAR_backend_pg_passwd'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_516', variable: 'TF_VAR_hostname_vcenter_516'),
                            string(credentialsId: 'TF_VAR_username_vcenter_516', variable: 'TF_VAR_username_vcenter_516'),
                            string(credentialsId: 'TF_VAR_password_vcenter_516', variable: 'TF_VAR_password_vcenter_516'),
                            string(credentialsId: 'TF_VAR_hostname_vcenter_k', variable: 'TF_VAR_hostname_vcenter_k'),
                            string(credentialsId: 'TF_VAR_username_vcenter_k', variable: 'TF_VAR_username_vcenter_k'),
                            string(credentialsId: 'TF_VAR_password_vcenter_k', variable: 'TF_VAR_password_vcenter_k')
                        ]) {
                            withVault([configuration: vaultConfiguration, vaultSecrets: secretsVcenter]) {
                                def vcenterHostRaw = (params.Site == 'vsphere-516') ? env.TF_VAR_hostname_vcenter_516 : env.TF_VAR_hostname_vcenter_k
                                env.VSPHERE_SERVER = vcenterHostRaw?.trim()?.replaceAll('(?i)^https?://', '')?.replaceAll('/.*', '') ?: ''
                                env.VCENTER_SITE   = params.Site
                                sh '''
                                    . "${WORKSPACE}/pipelines/conf/vsphere-preflight.sh"
                                    vsphere_preflight
                                    terragrunt apply -auto-approve -lock=true
                                '''
                            }
                        }
                    }
                }
            }
        }
    }
}
